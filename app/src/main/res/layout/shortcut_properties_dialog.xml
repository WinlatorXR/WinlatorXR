<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/play_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Number of times played: "
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/playtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Playtime: "
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/target_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target: "
        android:textSize="16sp"
        android:textIsSelectable="true"
        android:paddingBottom="8dp" />

    <!-- Only shown for a shortcut that runs the game through a .lnk, where the path above is the
         .lnk rather than the game. -->
    <TextView
        android:id="@+id/target_link_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textIsSelectable="true"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/reset_properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Properties"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

</LinearLayout>
