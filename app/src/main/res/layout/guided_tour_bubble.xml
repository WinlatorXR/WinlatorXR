<?xml version="1.0" encoding="utf-8"?>
<!-- The explanation shown next to the spotlit button during a guided tour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp"
    android:clickable="true"
    android:background="@drawable/guided_tour_bubble">

    <TextView
        android:id="@+id/TVTourCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#80d8ff" />

    <TextView
        android:id="@+id/TVTourText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:lineSpacingExtra="3dp"
        android:textSize="16sp"
        android:textColor="#ffffff" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTTourSkip"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tour_skip"
            android:textColor="#b3ffffff" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/BTTourBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tour_back"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/BTTourNext"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80d8ff"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
