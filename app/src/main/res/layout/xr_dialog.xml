<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">

    <TextView
        android:id="@+id/TVToApplyClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/to_apply_close"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/CBUseXR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/use_xr"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/CBEnableImmersiveMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xr_selector"
        android:text="@string/use_immersive_mode" />

    <CheckBox
        android:id="@+id/CBEnableSBS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xr_selector"
        android:text="@string/use_sbs" />

    <CheckBox
        android:id="@+id/CBEnableCurvedScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xr_selector"
        android:text="@string/use_curved_screen" />

    <CheckBox
        android:id="@+id/CBEnablePassthrough"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xr_selector"
        android:text="@string/use_pt" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp"
        android:background="@color/colorPrimary"/>

    <CheckBox
        android:id="@+id/CBPlayerXRMouse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/xr_selector"
        android:text="@string/controller_as_mouse" />

    <CheckBox
        android:id="@+id/CBPlayerXRMouseLeftHanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/xr_selector"
        android:text="@string/left_handed_mouse" />

    <CheckBox
        android:id="@+id/CBPlayerXRMouseLightgun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/xr_selector"
        android:text="@string/light_gun_mouse" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/controller_profile" />

        <LinearLayout
            android:id="@+id/LLSpinnerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SControllerPreset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:spinnerMode="dialog" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTAddControllerPreset"
                android:src="@drawable/icon_add" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTEditControllerPreset"
                android:src="@drawable/icon_edit" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTDuplicateControllerPreset"
                android:src="@drawable/icon_duplicate" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTRemoveControllerPreset"
                android:layout_marginRight="0dp"
                android:src="@drawable/icon_remove" />
        </LinearLayout>
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:choiceMode="singleChoice"/>
</LinearLayout>
</ScrollView>