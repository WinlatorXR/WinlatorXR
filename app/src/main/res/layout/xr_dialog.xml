<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/LLDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TVToApplyClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/to_apply_close"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/colorAccent"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- TWO COLUMN ROOT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- LEFT COLUMN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <!-- RENDERING -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout style="@style/FieldSet">
                            <CheckBox
                                android:id="@+id/CBUseXR"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/use_xr"
                                android:visibility="gone" />

                            <CheckBox
                                android:id="@+id/CBEnableImmersiveMode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_immersive_mode" />

                            <LinearLayout
                                android:id="@+id/LLHeadTurnSensitivity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/xr_head_turn_sensitivity" />

                                <com.winlator.cmod.widget.SeekBar
                                    android:id="@+id/SBHeadTurnSensitivity"
                                    android:layout_width="match_parent"
                                    android:layout_height="30dp"
                                    android:background="@drawable/xr_selector"
                                    app:sbMaxValue="150"
                                    app:sbMinValue="50"
                                    app:sbStep="5" />
                            </LinearLayout>

                            <CheckBox
                                android:id="@+id/CBEnableSBS"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_sbs" />

                            <CheckBox
                                android:id="@+id/CBSBSStretch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_sbs_stretch"
                                android:visibility="gone" />

                            <CheckBox
                                android:id="@+id/CBSBSTrim"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/sbs_edge_trim"
                                android:visibility="gone" />

                            <CheckBox
                                android:id="@+id/CBEnableCurvedScreen"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_curved_screen" />

                            <CheckBox
                                android:id="@+id/CBEnablePassthrough"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_pt" />

                            <CheckBox
                                android:id="@+id/CBDisableEnvironment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/disable_environment"
                                android:visibility="gone" />

                            <CheckBox
                                android:id="@+id/CBShowFPS"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/xr_show_fps" />

                            <CheckBox
                                android:id="@+id/CBFovPassthrough"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/use_fov_passthrough"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/LLColourKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <!-- Above the list, so it can be reached without scrolling through the colours -->
                                <LinearLayout
                                    android:id="@+id/LLColourKeyTolerance"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="@string/xr_colour_key_tolerance" />

                                    <com.winlator.cmod.widget.SeekBar
                                        android:id="@+id/SBColourKeyTolerance"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:background="@drawable/xr_selector"
                                        app:sbMaxValue="100"
                                        app:sbMinValue="10"
                                        app:sbStep="5" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/xr_colour_key" />

                                <RadioGroup
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/color_none"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/xr_colour_key_off"
                                        android:textSize="8dp" />

                                    <RadioButton
                                        android:id="@+id/color_green"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:button="@drawable/radio_square"
                                        android:buttonTint="#00FF00"
                                        android:text="@string/xr_colour_key_green"
                                        android:textSize="8dp" />

                                    <RadioButton
                                        android:id="@+id/color_blue"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:button="@drawable/radio_square"
                                        android:buttonTint="#0000FF"
                                        android:text="@string/xr_colour_key_blue"
                                        android:textSize="8dp" />

                                    <RadioButton
                                        android:id="@+id/color_pink"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:button="@drawable/radio_square"
                                        android:buttonTint="#FF00FF"
                                        android:text="@string/xr_colour_key_pink"
                                        android:textSize="8dp" />

                                    <RadioButton
                                        android:id="@+id/color_black"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:button="@drawable/radio_square"
                                        android:buttonTint="#000000"
                                        android:text="@string/xr_colour_key_black"
                                        android:textSize="8dp"/>
                                </RadioGroup>
                            </LinearLayout>

                            <CheckBox
                                android:id="@+id/CBDisableStartupHints"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/xr_selector"
                                android:text="@string/xr_disable_startup_hints" />

                            <TextView
                                android:id="@+id/TVEnvironment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/xr_environment" />

                            <LinearLayout
                                android:id="@+id/LLEnvironment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <Spinner
                                    style="@style/ComboBox"
                                    android:id="@+id/SEnvironment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:spinnerMode="dialog" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTImportEnvironment"
                                    android:contentDescription="@string/xr_environment_import"
                                    android:src="@drawable/icon_add" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTRemoveEnvironment"
                                    android:contentDescription="@string/xr_environment_remove"
                                    android:layout_marginRight="0dp"
                                    android:src="@drawable/icon_remove" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/IVEnvironmentPreview"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_marginTop="6dp"
                                android:scaleType="centerCrop"
                                android:importantForAccessibility="no"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/TVXServer"
                            style="@style/FieldSetLabel"
                            android:text="@string/rendering" />
                    </FrameLayout>
                </LinearLayout>

                <!-- RIGHT COLUMN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <!-- INPUT -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout style="@style/FieldSet">

                            <CheckBox
                                android:id="@+id/CBPlayerXRGamepad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/controllers_as_gamepad" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRThumbrestDpad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/xr_thumbrest_gamepad" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRKeys"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/controllers_as_keys" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRMouse"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/controller_as_mouse" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRMouseLeftHanded"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/left_handed_mouse" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRMouseLightgun"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/light_gun_mouse" />

                            <CheckBox
                                android:id="@+id/CBPlayerXRLightgunHaptic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/light_gun_haptic" />

                            <CheckBox
                                android:id="@+id/CBRelativeMouse"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/xr_selector"
                                android:text="@string/relative_mouse_movement" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/controller_profile" />

                            <LinearLayout
                                android:id="@+id/LLSpinnerLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <Spinner
                                    style="@style/ComboBox"
                                    android:id="@+id/SControllerPreset"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:spinnerMode="dialog" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTAddControllerPreset"
                                    android:src="@drawable/icon_add" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTEditControllerPreset"
                                    android:src="@drawable/icon_edit" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTDuplicateControllerPreset"
                                    android:src="@drawable/icon_duplicate" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTRemoveControllerPreset"
                                    android:layout_marginRight="0dp"
                                    android:src="@drawable/icon_remove" />
                            </LinearLayout>
                            <ListView
                                android:id="@+id/listView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="true"
                                android:choiceMode="singleChoice"/>
                        </LinearLayout>

                        <TextView
                            style="@style/FieldSetLabel"
                            android:text="@string/input" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>