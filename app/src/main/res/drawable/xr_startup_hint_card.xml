<?xml version="1.0" encoding="utf-8"?>
<!-- The panel behind a startup hint. Tinted rather than outlined alone: in a headset the
     dialog is drawn as a bitmap on a white ground, and a fill separates the hint from the
     status line above it at a distance where a hairline rule does not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#142F0B81" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="#4D0288D1" />
</shape>
